  "query": "\n        SELECT p.id, p.name, p.product_type, pp.amount_cents\n        FROM products p\n        JOIN product_prices pp ON p.id = pp.product_id\n        WHERE p.product_id = $1 AND pp.currency = $2 AND p.is_active = true\n        ",
