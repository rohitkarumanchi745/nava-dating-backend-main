{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.product_id, p.name, p.description, p.product_type,\n               pp.currency, pp.amount_cents\n        FROM products p\n        JOIN product_prices pp ON p.id = pp.product_id\n        WHERE p.is_active = true\n        ORDER BY p.sort_order, pp.currency\n        ",
