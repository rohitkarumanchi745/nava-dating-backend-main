-- Migration: Global University Discovery System
-- Comprehensive country-wise university database for NAVA global platform

-- ============================================================================
-- Universities Registry (Global Database)
-- ============================================================================
CREATE TABLE IF NOT EXISTS universities (
    id BIGSERIAL PRIMARY KEY,
    name VARCHAR(255) NOT NULL,
    short_name VARCHAR(100),
    domain VARCHAR(255) NOT NULL,
    country VARCHAR(100) NOT NULL,
    country_code VARCHAR(3) NOT NULL,
    state_province VARCHAR(100),
    city VARCHAR(100),
    tier VARCHAR(20) DEFAULT 'regular',
    is_active BOOLEAN DEFAULT TRUE,
    student_population INTEGER,
    ranking_national INTEGER,
    created_at TIMESTAMP DEFAULT NOW(),
    updated_at TIMESTAMP DEFAULT NOW()
);

CREATE UNIQUE INDEX IF NOT EXISTS idx_universities_domain ON universities(domain);
CREATE INDEX IF NOT EXISTS idx_universities_country ON universities(country_code, is_active);
CREATE INDEX IF NOT EXISTS idx_universities_name ON universities(name);
CREATE INDEX IF NOT EXISTS idx_universities_tier ON universities(tier, country_code);

-- ============================================================================
-- Update student_verifications with university link
-- ============================================================================
ALTER TABLE student_verifications
ADD COLUMN IF NOT EXISTS university_id BIGINT REFERENCES universities(id),
ADD COLUMN IF NOT EXISTS country_code VARCHAR(3);

CREATE INDEX IF NOT EXISTS idx_student_verifications_uni ON student_verifications(university_id, status);
CREATE INDEX IF NOT EXISTS idx_student_verifications_country ON student_verifications(country_code, status);

-- ============================================================================
-- University Discovery Passes
-- ============================================================================
CREATE TABLE IF NOT EXISTS university_passes (
    id BIGSERIAL PRIMARY KEY,
    user_id BIGINT NOT NULL REFERENCES users(id) ON DELETE CASCADE,
    pass_type VARCHAR(20) NOT NULL,
    country_code VARCHAR(3),
    status VARCHAR(20) DEFAULT 'active',
    start_date TIMESTAMP DEFAULT NOW(),
    end_date TIMESTAMP,
    amount_paid DECIMAL(10,2),
    currency VARCHAR(3) DEFAULT 'USD',
    payment_id VARCHAR(255),
    created_at TIMESTAMP DEFAULT NOW(),
    CONSTRAINT valid_pass_type CHECK (pass_type IN ('country', 'global'))
);

CREATE INDEX IF NOT EXISTS idx_university_passes_user ON university_passes(user_id, status, end_date);
CREATE INDEX IF NOT EXISTS idx_university_passes_country ON university_passes(country_code, status);

